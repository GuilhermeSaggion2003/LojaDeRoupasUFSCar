rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Cada utilizador autenticado lê apenas o seu próprio documento de perfil.
    // A escrita é bloqueada: perfis são atribuídos pelo console do Firebase.
    // -----------------------------------------------------------------------
    match /usuarios/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Função auxiliar: retorna o perfil ('gerente' | 'funcionario') do utilizador logado.
    function getPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    // -----------------------------------------------------------------------
    // Formato obrigatório de um produto. O preço é guardado em centavos
    // (inteiro) para evitar erros de arredondamento.
    // -----------------------------------------------------------------------
    function produtoValido(p) {
      return p.keys().hasAll(['nome', 'tamanho', 'cor', 'preco', 'categoria', 'estoque', 'criadoEm', 'atualizadoEm'])
        && p.keys().hasOnly(['nome', 'tamanho', 'cor', 'preco', 'categoria', 'estoque', 'criadoEm', 'atualizadoEm'])
        && p.nome is string && p.nome.size() > 0 && p.nome.size() <= 100
        && p.tamanho is string && p.tamanho.size() > 0 && p.tamanho.size() <= 20
        && p.cor is map && p.cor.keys().hasOnly(['nome', 'hex'])
        && p.cor.nome is string && p.cor.nome.size() > 0 && p.cor.nome.size() <= 40
        && p.cor.hex is string && p.cor.hex.matches('^#[0-9a-fA-F]{6}$')
        && p.preco is int && p.preco > 0 && p.preco <= 10000000
        && p.categoria in ['Camisetas', 'Moletons', 'Calças', 'Bonés', 'Acessórios']
        && p.estoque is int && p.estoque >= 0
        && p.criadoEm is timestamp && p.atualizadoEm is timestamp;
    }

    // -----------------------------------------------------------------------
    // Formato obrigatório de uma movimentação de estoque.
    // Campos exatos: produtoId, tipo, quantidade, data, usuarioId
    // e opcionalmente vendaId (quando originada da finalização de uma venda).
    // Campos extras são bloqueados por hasOnly.
    // -----------------------------------------------------------------------
    function movimentacaoValida(m) {
      return m.keys().hasAll(['produtoId', 'tipo', 'quantidade', 'data', 'usuarioId'])
        && (
          m.keys().hasOnly(['produtoId', 'tipo', 'quantidade', 'data', 'usuarioId'])
          || m.keys().hasOnly(['produtoId', 'tipo', 'quantidade', 'data', 'usuarioId', 'vendaId'])
        )
        && m.produtoId is string && m.produtoId.size() > 0
        && m.tipo in ['entrada', 'saida']
        && m.quantidade is int && m.quantidade > 0
        && m.data is timestamp && m.data == request.time
        && m.usuarioId is string && m.usuarioId == request.auth.uid
        && (!('vendaId' in m) || (m.vendaId is string && m.vendaId.size() > 0));
    }

    // -----------------------------------------------------------------------
    // Formato obrigatório de uma transação de venda (RF05/RF06).
    // Validação estrita de campos, cálculo em centavos inteiros (RNF03),
    // coerência aritmética de totais e restrição de desconto para vendas.
    // -----------------------------------------------------------------------
    function vendaValida(v) {
      return v.keys().hasAll(['itens', 'subtotal', 'desconto', 'total', 'tipo', 'data', 'usuarioId'])
        && (
          v.keys().hasOnly(['itens', 'subtotal', 'desconto', 'total', 'tipo', 'data', 'usuarioId'])
          || v.keys().hasOnly(['itens', 'subtotal', 'desconto', 'total', 'tipo', 'data', 'usuarioId', 'operadorNome'])
          || v.keys().hasOnly(['itens', 'subtotal', 'desconto', 'total', 'tipo', 'data', 'usuarioId', 'itensDevolvidos'])
          || v.keys().hasOnly(['itens', 'subtotal', 'desconto', 'total', 'tipo', 'data', 'usuarioId', 'itensDevolvidos', 'operadorNome'])
        )
        && v.itens is list && v.itens.size() > 0 && v.itens.size() <= 100
        && v.subtotal is int && v.subtotal >= 0
        && v.desconto is int && v.desconto >= 0 && v.desconto <= v.subtotal
        && v.total is int && v.total >= 0 && v.total == (v.subtotal - v.desconto)
        && v.tipo in ['venda', 'troca', 'devolucao']
        && (v.tipo == 'venda' || v.desconto == 0)
        && v.data is timestamp && v.data == request.time
        && v.usuarioId is string && v.usuarioId == request.auth.uid
        && (!('operadorNome' in v) || (v.operadorNome is string && v.operadorNome.size() > 0 && v.operadorNome.size() <= 100))
        && (!('itensDevolvidos' in v) || (v.tipo == 'troca' && v.itensDevolvidos is list && v.itensDevolvidos.size() > 0));
    }

    // -----------------------------------------------------------------------
    // Restrições de Produtos
    // -----------------------------------------------------------------------
    match /produtos/{produtoId} {
      allow read: if request.auth != null;

      // Produto nasce com estoque zero: entradas são registradas no módulo de Estoque.
      allow create: if request.auth != null && getPerfil() == 'gerente'
        && produtoValido(request.resource.data)
        && request.resource.data.estoque == 0
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;

      allow update: if request.auth != null
        && produtoValido(request.resource.data)
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.atualizadoEm == request.time
        && (
          // Caminho 1 — edição de metadados: apenas gerente, estoque inalterado
          (
            getPerfil() == 'gerente'
            && request.resource.data.estoque == resource.data.estoque
          )
          ||
          // Caminho 2 — atualização de estoque via movimentação atômica manual do gerente:
          (
            getPerfil() == 'gerente'
            && request.resource.data.estoque != resource.data.estoque
            && (
              // Verifica movimentação de entrada: saldo aumenta
              (
                request.resource.data.estoque > resource.data.estoque
                && existsAfter(/databases/$(database)/documents/estoque/$(produtoId + '_entrada'))
                && getAfter(/databases/$(database)/documents/estoque/$(produtoId + '_entrada')).data.produtoId == produtoId
                && getAfter(/databases/$(database)/documents/estoque/$(produtoId + '_entrada')).data.tipo == 'entrada'
                && getAfter(/databases/$(database)/documents/estoque/$(produtoId + '_entrada')).data.quantidade == (request.resource.data.estoque - resource.data.estoque)
              )
              ||
              // Verifica movimentação de saída: saldo diminui, nunca negativo
              (
                request.resource.data.estoque < resource.data.estoque
                && request.resource.data.estoque >= 0
                && existsAfter(/databases/$(database)/documents/estoque/$(produtoId + '_saida'))
                && getAfter(/databases/$(database)/documents/estoque/$(produtoId + '_saida')).data.produtoId == produtoId
                && getAfter(/databases/$(database)/documents/estoque/$(produtoId + '_saida')).data.tipo == 'saida'
                && getAfter(/databases/$(database)/documents/estoque/$(produtoId + '_saida')).data.quantidade == (resource.data.estoque - request.resource.data.estoque)
              )
            )
          )
          ||
          // Caminho 3 — abatimento ou incremento de estoque pelo funcionário no PDV (venda, troca ou devolução):
          // Todos os metadados fixos permanecem inalterados e o saldo resultante nunca pode ser negativo.
          (
            getPerfil() == 'funcionario'
            && request.resource.data.estoque != resource.data.estoque
            && request.resource.data.estoque >= 0
            && request.resource.data.nome == resource.data.nome
            && request.resource.data.tamanho == resource.data.tamanho
            && request.resource.data.cor == resource.data.cor
            && request.resource.data.preco == resource.data.preco
            && request.resource.data.categoria == resource.data.categoria
          )
        );

      allow delete: if request.auth != null && getPerfil() == 'gerente';
    }

    // -----------------------------------------------------------------------
    // Restrições de Estoque
    //
    // Movimentações são IMUTÁVEIS: apenas create é permitido (sem update/delete).
    // Gerente: cria movimentações manuais avulsas.
    // Funcionário: cria movimentações associadas a uma venda válida com vendaId.
    // -----------------------------------------------------------------------
    match /estoque/{movId} {
      // Gerente e funcionário leem o histórico de movimentações
      allow read: if request.auth != null;

      // Criação de movimentações:
      allow create: if request.auth != null
        && movimentacaoValida(request.resource.data)
        && (
          getPerfil() == 'gerente'
          || (
            getPerfil() == 'funcionario'
            && 'vendaId' in request.resource.data
            && existsAfter(/databases/$(database)/documents/vendas/$(request.resource.data.vendaId))
          )
        );

      // Movimentações são imutáveis: update e delete sempre negados
      allow update: if false;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Restrições de Vendas (RF05/RF06)
    //
    // - Criação: usuários autenticados (gerente ou funcionário) com payload
    //   estritamente validado por vendaValida.
    // - Leitura: restrita ao perfil gerente (conforme RF01 e PGP).
    // - Imutabilidade: update e delete permanentemente bloqueados.
    // -----------------------------------------------------------------------
    match /vendas/{vendaId} {
      allow create: if request.auth != null && vendaValida(request.resource.data);
      allow read: if request.auth != null && getPerfil() == 'gerente';
      allow update: if false;
      allow delete: if false;
    }
  }
}
