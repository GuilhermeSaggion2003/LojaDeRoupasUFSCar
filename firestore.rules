rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se a requisição vem de um usuário logado
    function isAutenticado() {
      return request.auth != null;
    }

    match /produtos/{produtoId} {
      // Preliminar: Apenas logados podem ler e escrever.
      // Futuramente, a escrita (write) será restrita ao perfil "gerente".
      allow read, write: if isAutenticado();
    }
    
    match /estoque/{estoqueId} {
      allow read, write: if isAutenticado();
    }

    match /vendas/{vendaId} {
      allow read, write: if isAutenticado();
    }

    match /usuarios/{usuarioId} {
      // Preliminar: Usuário logado só pode ler e editar o seu próprio documento.
      allow read, write: if isAutenticado() && request.auth.uid == usuarioId;
    }
  }
}